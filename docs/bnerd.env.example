# ============================================================
# Bnerd deployment of wacrm. Copy to .env.local on the server and
# fill in. See docs/bnerd.md. Never commit the filled-in copy.
# ============================================================

# --- Supabase (Project Settings -> API) -------------------------
# The URL and anon key are public. The service-role key bypasses row
# security: server only, never in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- This app ---------------------------------------------------
# This app's public URL. Staging: crm.bnerdedu.com (see docs/bnerd.md, Hostnames).
NEXT_PUBLIC_SITE_URL=https://crm.bnerdedu.com
NEXT_PUBLIC_APP_LOCALE=en
# 64 hex characters. Encrypts the saved WhatsApp token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Meta ------------------------------------------------------
# Meta for Developers -> App Settings -> Basic -> App Secret.
# The phone number ID, WABA ID and access token are NOT env variables:
# an admin enters them in Sales -> WhatsApp settings, where they are
# stored encrypted.
META_APP_SECRET=

# --- Portal embedding ------------------------------------------
# Portal origins allowed to frame wacrm, comma-separated, no wildcards.
# Must share a parent domain with this app, or browsers block the
# session cookie inside the frame.
FRAME_ANCESTORS=https://portal.bnerdedu.com

# --- Portal single sign-on -------------------------------------
# Shared with Payload (same name there). 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WACRM_SSO_SECRET=
# The one shared account staff sign in to: not a secret, an id from
# `select id from accounts;` after the first sign-up (docs/bnerd.md, "First run").
WACRM_SSO_ACCOUNT_ID=

# --- Scheduled jobs --------------------------------------------
# Sent as x-cron-secret to /api/automations/cron and /api/flows/cron, by
# whatever calls them every minute. 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTOMATION_CRON_SECRET=
